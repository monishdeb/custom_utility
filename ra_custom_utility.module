/**
 * Implements hook_query_TAG_alter(): tag search_$type with $type node_search.
 */
function ra_custom_utility_query_search_node_search_alter(AlterableInterface $query) {
  // For testing purposes, restrict the query to node type 'article' only.
  $query->condition('n.type', array('article','story','event','page','audio','video'), 'IN');
}


/*
 * Used to get the full name of the user
 */

function ra_custom_utility_preprocess_menu(&$vars) {
   
  if ($vars['menu_name'] == 'menu-top-menu-user') {
  	$currentAccount = \Drupal::currentUser();
  	$uid = $currentAccount->id()?$currentAccount->id():0;
  	#$vars['#cache']['max-age'] = 0; 
  	foreach ($vars['items'] as $idx => $item) {
		if($item['title']=='Welcome') {
    	  $randcheck = '';            
		  //$currentAccount->id(); //To get User ID
		  if($uid == 1){
		  	//$randcheck = " - ".rand();
		  }
		  $currentAccount->getUsername();//To get User Name
		  $vars['items'][$idx]['title'] = "Welcome " .$currentAccount->getUsername() .$randcheck;
		}
      if($item['title']=='Login') {
				$dialog_options = Json::encode([ 'dialogClass' => 'login-popup-modal user-modal-popup' ]);
        $link_options = array(
                'attributes' => array(
	                'class' => array(
	                  'use-ajax ajax-login',
	                ),
	                'data-dialog-type' => array(
	                  'modal',
	                ),
	                'data-dialog-options' => $dialog_options,
                ),
              );
        $vars['items'][$idx]['url']->setOptions($link_options);
        //$vars['items'][$idx]['attributes']['class'] = "login-ajax-link__list-item";
        //$vars['items'][$idx]['attributes']['data-dialog-type'] = "logout-manoj";
        //ksm($item['attributes']);
        $vars['#attached']['library'][] = 'core/drupal.dialog.ajax';
		  }
      if($uid && $item['title']=='Login'){
      	unset($vars['items'][$idx]);
      }
    }
  }
}
