/*
 * Redirect all the pages of not in good standing user to home page except profile edit
 */
function not_in_good_standing_redirect(){  
    if((arg(0) != 'user' && arg(2) != 'edit' && arg(0) != 'node') || (arg(0) == 'user' && (arg(2) == 'orders' || arg(2) == 'petition' || arg(2) == 'downloads'))){ 
      $msg = "The page you are trying to access is restricted to RA members in good standing. There may be an issue with your account. Please contact our Business Manager, Gina Morales, (212.280.6062 or <a href='mailto:accounting@rabbinicalassembly.org'>accounting@rabbinicalassembly.org</a>) to resolve the issue and to restore your access. Thank you.";
      \Drupal::messenger()->addMessage(t($msg), 'error');
      $url = '/';
      $response = new Symfony\Component\HttpFoundation\RedirectResponse($url);
      $response->send();
      return;
    }
}
function arg($part){
    // To get system path
    $system_current_path = \Drupal::service('path.current')->getPath();
    $system_current_path  = ltrim($system_current_path ,'/');
    $chunks = explode('/',$system_current_path);
    if(!is_numeric($part)){ 
        return $chunks;
    }
    if(isset($chunks[$part])){
        return $chunks[$part];
    }else{
        return '';
    }
}
/*
 * Used to check whether the user made any order or not
 */

function check_user_orders($userId){
    $database_obj = \Drupal::database();
    $orderQuery = $database_obj->select('{commerce_order}','uco')
                             //$orderQuery->addExpression('COUNT(uco.uid)');
                             ->fields('uco',[uid])
                             ->condition('uid', $userId, '=')
                             ->execute()->fetchField();
    if(!$orderQuery && $userId > 0){
        \Drupal::messenger()->addMessage(t('The page you are trying to access is for Rabbinical Assembly members only.'),'error');
        $url = '/';
        $response = new Symfony\Component\HttpFoundation\RedirectResponse($url);
        $response->send();
        return;
        
    }  
}

