/*
 * hook_node_view implementation for displaying posted on date
 */

function ra_custom_utility_node_view(array &$build, \Drupal\Core\Entity\EntityInterface $entity, \Drupal\Core\Entity\Display\EntityViewDisplayInterface $display, $view_mode){ 
  $created_date = $entity->getCreatedTime(); 
  $node_type = $entity->getType(); 
  $style = '';
  if($view_mode != 'teaser'){
        if($entity->hasField('field_'.$node_type.'_hide_date')){
           if($entity->get('field_'.$node_type.'_hide_date')->getValue()[0]['value'] == '1' ) $style = '; display:none !important;';
        }
    if($node_type == 'site_pages'){
      $node_type = 'page';
    }if($node_type == 'notes'){ 
		 //print_r($build['field_notes_group']); exit(); 
		 $civi_id = $entity->get('field_civi_id')->getValue()[0]['value'];
		 $name =  get_fullname($civi_id);
		 $build['body'][0]['#text'] = '<div>'.$name.'</div><div class="field__label">Body</div>'.$build['body'][0]['#text'];
    } else if($node_type == 'event' || $node_type == 'page'){ 
      if($entity->get('field_'.$node_type.'_enable_posted_date')->getValue()[0]['value'] == '1' && $entity->get('field_'.$node_type.'_posted_on')->getValue()[0]['value'] != ''){
        $build['field_'.$node_type.'_posted_on'] = array();
       // $build['body'][0]['#text'] = '<div style="margin-bottom:10px '.$style.'"><b>Posted on: </b>'.date("l F j, Y", strtotime($entity->get('field_'.$node_type.'_posted_on')->getValue()[0]['value'])).'</div>'.$build['body'][0]['#text'];
      }
    } else if($entity->hasField('field_'.$node_type.'_enable_posted_date') && $entity->get('field_'.$node_type.'_enable_posted_date')->getValue()[0]['value'] == '' && $entity->get('field_'.$node_type.'_enable_posted_date')->getValue()[0]['value'] == '1' && $node_type !== 'product'){ 
        $build['field_'.$node_type.'_posted_on'] = array();
        $build['body'][0]['#text'] = '<div style="margin-bottom:10px '.$style.'"><b>Posted on: </b>'.date("l F j, Y", strtotime($entity->get('field_'.$node_type.'_posted_on')->getValue()[0]['value'])).'</div>'.$build['body'][0]['#text'];
    }else{ 
      if($entity->hasField('field_'.$node_type.'_posted_on')){  
        $build['field_'.$node_type.'_posted_on'] = array();
      } 
      $node_allowed = ['freelance','institution','congregation','position_congregation','position_institution','position_freelance','header_image','product'];   
      if(!in_array($node_type,$node_allowed)){   
        if($entity->hasField('body')){
		// comment out "posted on" from content types listed above
//          $build['body'][0]['#text'] = '<div style="margin-bottom:10px '.$style.'"><b>Posted on: </b>'.date("l F j, Y", $created_date).'</div>'.$build['body'][0]['#text'];

        } 

      }  
    }
  } 
}

/*
 * to change the text "add new comment" to "comments(3)"
 * and
 * to change the link of comment "node/[nodeid]#comment-form" to "node/[nodeid]#comments"
 */

function ra_custom_utility_preprocess_links(&$variables) {  
  if ( isset($variables['links']['comment-add']['link']['#title']) && isset($variables['links']['comment-add']['link']['#url']) && method_exists($variables['links']['comment-add']['link']['#url'], 'getRouteParameters')) {  
    $comment_count = 0;
    $node_id_params = $variables['links']['comment-add']['link']['#url']->getRouteParameters();
    $node_id = $node_id_params['node'];
    $comment_count_array = \Drupal::service('comment.statistics')->read(array_fill_keys([$node_id], ''), 'node');
    $comment_count = $comment_count_array[0]->comment_count;
    $variables['links']['comment-add']['link']['#title'] = "Comments (" .$comment_count.")";
    $variables['links']['comment-add']['link']['#options']['fragment'] = "comments";
  }
}

function check_notes_item_access($row=array()){

	if( \Drupal::currentUser()->id()==1){
		//return FALSE;
	}
	$current_user_id = \Drupal::currentUser()->id();
	$user = \Drupal\user\Entity\User::load($current_user_id);
	$field_notes_group = $user->get('field_notes_group')->getValue();
	if(!empty($field_notes_group)){ 
		foreach($field_notes_group as $group){ 
		$current_user_notes_group[] = $group['target_id'];
		}
	} 
	if($current_user_id == 1){
		$current_user_notes_group[] = 5701;
	}
	$loggedin_user_notes_group = $exp = $common_group = $current_row_group = array();
	$loggedin_user_notes_group =$current_user_notes_group;
	if(!empty($row->field_access_group_1)){
		$current_row_group = $row->field_access_group_1->__toString();
		$exp = explode(', ', $current_row_group);
		$common_group = array_intersect($exp, $loggedin_user_notes_group);
		//drupal_set_message('<pre>'. print_r($common_group, TRUE) .'</pre>');
		if(count($common_group) > 0){
			return FALSE;
		}else{
			return TRUE;
		}
	} else{
		return TRUE;
	}
}
