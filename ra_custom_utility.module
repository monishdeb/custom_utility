function ra_custom_utility_preprocess_views_view(&$variables) {
	$view = $variables['view'];
	  if ($view->id() == 'taxonomy_term' && $view->current_display == "page_1") {
		if (count($view->result) == 1) {
		  // Change view mode to teaser when there is only 1 item.
		  $variables['rows'][0]['#rows'][0]['#view_mode'] = 'full';
