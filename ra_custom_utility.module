function insertpdf_article_content(){
	$db = mysqli_connect('localhost', 'debian-sys-maint', 'byGeWa9b?WhBy3wZbMuV') or die(mysqli_error($db));
	mysqli_select_db($db,'radrupal7'); 
	mysqli_set_charset($db,"utf8");
		
    $orderQuery = $database_obj->select('{commerce_product}','cp')
				 //$orderQuery->addExpression('COUNT(uco.uid)');
				 ->fields('cp',['product_id'])
				 ->condition('type', 'cj_article', '=')
				 ->execute();
                   
	 foreach($orderQuery as $pid){
		 		$product = \Drupal\commerce_product\Entity\Product::load($pid->product_id);
				$field_cj_art_display_order = $product->get('field_cj_art_display_order')->getValue()[0]['value'];
				if($field_cj_art_display_order){
					$query1 = "SELECT a.field_cj_art_display_order_value,a.entity_id,b.field_cj_art_pdf_extract_value FROM `field_data_field_cj_art_display_order` a, field_data_field_cj_art_pdf_extract b WHERE a.entity_id=b.entity_id and a.field_cj_art_display_order_value='".$field_cj_art_display_order."'";
					$result1 = mysqli_query($db,$query1) or die(mysqli_error($db));
					while ($row1 = mysqli_fetch_object($result1)) {
						//break;
						$product->set('field_cj_art_pdf_extract',$row1->field_cj_art_pdf_extract_value);
					}
					$product_variation = \Drupal\commerce_product\Entity\ProductVariation::load($product->get('variations')->getValue()[0]['target_id']);
					$product_variation->setTitle($product->getTitle()); 
					$product_variation->save();
					$product->save();
					//break;
				}
	 }	
}
