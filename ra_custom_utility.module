/*
 * hook_views_query_alter implementation
 */
function ra_custom_utility_views_query_alter(ViewExecutable $view, QueryPluginBase $query) {
    $uid = \Drupal::currentUser()->id();
    $roles = \Drupal::currentUser()->getRoles(); 
       $database = \Drupal::database();
	  $view_id = $view->id();
	  $current_page = $view->current_display;
      if ($view->id() == 'cj_downloads_user') {
		$particle = array(0);
		$account1 = \Drupal::entityTypeManager()->getStorage('user')->load(arg(1));
		foreach($account1->get('field_cj_purchased_article')->getValue() as $value){
			$particle[] = $value['value'];
		}
		foreach($account1->get('field_cj_purchased_issue')->getValue() as $value){
			$particle[] = $value['value'];
		}
		
		$counter = count($query->where);
		$counter = $counter + 1;
		
		$query->where[$counter]['type'] = 'AND';
		$query->where[$counter]['conditions'][] = array(
		'field' => 'commerce_product_field_data.product_id',
		'value' => $particle,
		'operator' => "in"
		);
	}
	if($view_id =='placement_referrals' && $current_page == "page_2") {
       foreach($query->where[1]['conditions'] as $key=>$condi){
			if($condi['field']=='field_placement_position_field_collection_item.uid'){
				//$query->where[1]['conditions'][$key]['field']='field_placement_position_field_collection_item.uid';
				$query->where[1]['conditions'][$key]['value'] = $uid;
				}
				
			if($condi['field']=='field_placement_position_field_collection_item.type' && in_array('placement_congregation', $roles)){
			$query->where[1]['conditions'][$key]['value'] = array('position_congregation');
			}
			if($condi['field']=='field_placement_position_field_collection_item.type' && in_array('placement_freelance', $roles)){
			$query->where[1]['conditions'][$key]['value'] = array('position_freelance');
			}
			if($condi['field']=='field_placement_position_field_collection_item.type'  && in_array('placement_institution', $roles)){
			$query->where[1]['conditions'][$key]['value'] = array('position_institution');
			}
		}
}
  if(($view_id == 'user_search' && $current_page == "page_1") || $view_id == 'membersearch' ) {
  	//dpm($view_id);
  	if(isset($_GET['address_type']) && $_GET['address_type']=='work') {
  	
  	foreach($query->where[1]['conditions'] as $key=>$condi){
    //dpm($condi['field']."=$key==".count($query->where[1]['conditions']));
		if($condi['field']=='contact_id_civicrm_contact.country_id'){
			$query->where[1]['conditions'][$key]['field']='contact_id_civicrm_contact_1.country_id';
		}
		if($condi['field']=='contact_id_civicrm_contact.state_province_id'){
			$query->where[1]['conditions'][$key]['field']='contact_id_civicrm_contact_1.state_province_id';
		}
		if($condi['field']=='contact_id_civicrm_contact.city'){
			$query->where[1]['conditions'][$key]['field']='contact_id_civicrm_contact_1.city';
		}
		if($condi['field']=='contact_id_civicrm_contact.postal_code'){
			$query->where[1]['conditions'][$key]['field']='contact_id_civicrm_contact_1.postal_code';
		}
		
	}
  foreach($query->where[0]['conditions'] as $key=>$condi){
        if($condi['field']=='contact_id_civicrm_contact.state_province_id = :civicrm_address_state_province_id'){
          $query->where[0]['conditions'][$key]['field']='contact_id_civicrm_contact_1.state_province_id = :civicrm_address_state_province_id';
        }
    }
  }
  
  }
  //dpm($query->where);
	if($view_id == 'notes' && $current_page =='data_export_2') {
	$current_user_id = \Drupal::currentUser()->id();
	$user = \Drupal\user\Entity\User::load($current_user_id);
	$field_notes_group = $user->get('field_notes_group')->getValue();
	if(!empty($field_notes_group)){ 
		foreach($field_notes_group as $group){ 
		$current_user_notes_group[] = $group['target_id'];
		}
	} 
	if($current_user_id == 1){
		//$current_user_notes_group[] = 5701;
	}
	$nids = taxonomy_select_nodes($current_user_notes_group);
	if(sizeof($nids)==0){
		$nids[]=0;
	}
	$counter = count($query->where);
  		$counter = $counter + 1;
	    $query->where[$counter]['type'] = 'AND';
	    $query->where[$counter]['conditions'][] = array(
	      'field' => 'node_field_data.nid',
	      'value' => $nids,
	      'operator' => "IN"
	    );
	}
  	
	
  
   	if($view_id == 'notes' && $current_page =='data_export_2') {
	$current_user_id = \Drupal::currentUser()->id();
	$user = \Drupal\user\Entity\User::load($current_user_id);
	$field_notes_group = $user->get('field_notes_group')->getValue();
	if(!empty($field_notes_group)){ 
		foreach($field_notes_group as $group){ 
		$current_user_notes_group[] = $group['target_id'];
		}
	} 
	if($current_user_id == 1){
		//$current_user_notes_group[] = 5701;
	}
	$nids = taxonomy_select_nodes($current_user_notes_group);
	if(sizeof($nids)==0){
		$nids[]=0;
	}
	$counter = count($query->where);
  		$counter = $counter + 1;
	    $query->where[$counter]['type'] = 'AND';
	    $query->where[$counter]['conditions'][] = array(
	      'field' => 'node_field_data.nid',
	      'value' => $nids,
	      'operator' => "IN"
	    );
	}   
  
}

