function get_civi_discount_details($cid=28157,$event_id=''){
	$database_obj = \Drupal::database();
	$data['code']='';
	$data['id']=0;
	$data['source']='';
	$query = $database_obj->query("SELECT source FROM `civicrm_participant` WHERE event_id = ".$event_id." ORDER BY `civicrm_participant`.`discount_id` DESC limit 0,1");      
	$data1 = $query->fetchAll();
    foreach($data1 as $temp){
		$data['source']=$temp->source;
		}
	$query = $database_obj->query("SELECT `id` from `civicrm_contribution` WHERE contact_id=".$cid." and source like '%".$data['source']."%'");      
	$data1 = $query->fetchAll();
    foreach($data1 as $temp){
		$data['id']=$temp->id;
		}
	$query = $database_obj->query("SELECT b.code FROM `cividiscount_track` a, `cividiscount_item` b WHERE a.item_id = b.id AND a.contribution_id=".$data['id']);      
	$data0 = $query->fetchAll();
	 foreach($data0 as $temp){
		$data['code']=$temp->code;
		}
	
	return $data;
}
