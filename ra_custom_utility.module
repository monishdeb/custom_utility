	],
];
$attachments['#attached']['html_head'][] = [$img, 'og:image'];


}
}

/* Get all the nodes related to the taxonomy
   */

  function taxonomy_select_nodes($termIds) {
    $nodeIds = array();
    $termIds = (array) $termIds;
    if (empty($termIds)) {
      return $nodeIds;
    }
    $query = \Drupal::database()->select('taxonomy_index', 'ti');
    $query->fields('ti', array('nid'));
    $query->condition('ti.tid', $termIds, 'IN');
    $query->distinct(TRUE);
    $result = $query->execute();
    if ($nodeIds = $result->fetchCol()) {
      return $nodeIds;
    }

    return $nodeIds;
  }

/*
 * Rearranging the donation fields while displaying
 */

function ra_custom_utility_civicrm_buildForm($formName, &$form){ 
   // Load Current user
	$current_user = \Drupal::currentUser();
	// Load Current user roles
	$roles = $current_user->getRoles();
	// Load Current user id
	$uid = $current_user->id();
	//ksm($form->_id);
  if($formName == "CRM_Contribute_Form_Contribution_Main" && $form->_id == 6 ){
    // Making $ 36.00 as $36.00 etc in amount section
    if($form->elementExists('price_80')){
      $amounts = & $form->getElement('price_80');
      $elements = & $amounts->getElements();
      foreach($elements as $key => $val){
        $text = $elements[$key]->getText();
        if($text != 'Other Amount'){
          $text = str_replace(' ', '', $text);
        } else{ 
          $elements[$key]->setValue(1);
        }
        $elements[$key]->setText($text);
      }
    }
  }
  // Dues management for contribution form id=11 is handled by the
  // custom_utility_civicrm CiviCRM extension (custom_utility.php).
  // The extension manages: declaration pre-condition checks, override lookups,
  // dues amount locking, and installment-split UI.
}

/**
 * Implements hook_form_FORM_ID_alter()
 *
 * FORM_ID = views_exposed_form
 */
function ra_custom_utility_form_views_exposed_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  #print_R($view['view']->id());
  $view_ids = ['cj_downloads_admin_view'];
  $view = $form_state->getStorage('view');
  #$form['#attributes']['novalidate'] = 'novalidate';
  if ($form_id == 'views_exposed_form' && ($view['view']->id() == 'teshuvot')){
			// Load Current user id
			$query = \Drupal::database()->query("SELECT node_field_data.title AS node_field_data_title, node_field_data.nid AS nid
																					FROM
																					{node_field_data} node_field_data
																					INNER JOIN {node__field_author_type} node__field_author_type ON node_field_data.nid = node__field_author_type.entity_id AND node__field_author_type.deleted = '0'
																					WHERE ((node__field_author_type.field_author_type_value = 'Teshuvot Author')) AND ((node_field_data.status = '1') AND (node_field_data.type IN ('cj_author')))
																					ORDER BY node_field_data_title ASC");      
      $data = $query->fetchAll();
      $options=['' => ' - Any - '];
      foreach($data as $row){
				$options[$row->nid] = $row->node_field_data_title;
			}   
			
			$form['field_teshu_author'] = array (
				'#type' => 'select2',
				'#value' => isset($_GET['field_teshu_author']) && !empty($_GET['field_teshu_author']) ? $_GET['field_teshu_author'] : '',
				'#options' => $options);
	}
  if ($form_id == 'views_exposed_form' && ($view['view']->id() == 'user_search' || $view['view']->id() == 'membersearch')) {
   
   // Load Current user
	$current_user = \Drupal::currentUser();
	// Load Current user roles
	$roles = $current_user->getRoles();
	
	if((in_array('superadmin',$roles) || in_array('administrator', $roles))){
		//ksm(fome)
	}else{
		$form['custom_20']['#options']=array('member' =>'Member','widow' =>'Widow/Widower');
		$form['custom_20']['#default_value']="member";
	}
	// Load Current user id
    $form['country_id'] = array (
      '#type' => 'select',
      '#value' => isset($_GET['country_id']) && !empty($_GET['country_id']) ? $_GET['country_id'] : 0,
      '#options' => get_country_list(),
      '#ajax' => array(
        'callback' => 'custom_dropdown_ajax_callback',
        'wrapper' => 'states-wrapper',
        'url' => \Drupal\Core\Url::fromRoute('ra_utility.getstates'),
      )
    );

    $form['state_province_id'] = array (
      '#type' => 'select',
      '#value' => isset($_GET['state_province_id']) && !empty($_GET['state_province_id']) ? $_GET['state_province_id'] : 0,
      '#options' => get_province_list($form['country_id']['#value']),
      '#prefix' => '<div id="states-wrapper">',
      '#suffix' => '</div>',
    );
    
    // Load Current user id
    $form['address_type'] = array (
      '#title' => t('Address Type'),
      '#type' => 'select',
      '#value' => isset($_GET['address_type']) && !empty($_GET['address_type']) ? $_GET['address_type'] : 'home',
      '#options' => array('home'=>'Home','work'=>'Work'),
    );
  }
}

/*
 * Getting civicrm countries list
 */
function get_country_list() {
  // Initialize CiviCRM.
  \Drupal::service('civicrm')->initialize();
  $top_country=array(''=>'- Any -','1228'=>'United States','1039'=>'Canada','1010'=>'Argentina','1165'=>'Palestine, State of');   
  $country_list = [];
  try{
    $result = civicrm_api3('Country', 'get', array('version' => 3, 'options' => array('limit' => 0, 'sort' => "name ASC")));
    if(!empty($result['values'])) {
      foreach($result['values'] as $country) {
		  if(!in_array($country['name'],$top_country)){
			$country_list[$country['id']] = $country['name'];
		  }
      }
      unset($top_country[1165]);
      $country_list = $top_country+$country_list;
    }
  } catch (CiviCRM_API3_Exception $e) {
    $error_message = array(
                        'error_message' => $e->getMessage(),
                        'error_code' => $e->getErrorCode(),
                        'error_data' => $e->getExtraParams(),
                      );
    \Drupal::logger('ra_custom_utility')->error(print_r($error_message, true));
  }
  return $country_list;
}

/*
 * Getting civicrm state/province list from a country
 */
function get_province_list($country_id = 0) {
  $state_list = array('- Any -');

  if(!$country_id) {
    return $state_list;
  }

  // Initialize CiviCRM.
  \Drupal::service('civicrm')->initialize();
    
  try{
    $result = civicrm_api3('StateProvince', 'get', array('country_id' => $country_id, 'version' => 3, 'options' => array('limit' => 0, 'sort' => "name ASC")));
    if(!empty($result['values'])) {
      foreach($result['values'] as $state) {
        $state_list[$state['id']] = $state['name'];
      }
    }
  } catch (CiviCRM_API3_Exception $e) {
    $error_message = array(
                        'error_message' => $e->getMessage(),
                        'error_code' => $e->getErrorCode(),
                        'error_data' => $e->getExtraParams(),
                      );
    \Drupal::logger('ra_custom_utility')->error(print_r($error_message, true));
  }
  return $state_list;
}
