/**
 * Prepares variables for views field templates.
 * 
 */
 
function ra_custom_utility_preprocess_views_view_field(&$variables) {
	
	if (isset($variables['view']) && ($variables['view']->storage->id() == 'commerce_cart_form')) {
    
		if ($variables['field']->field_alias == 'views_php_1' || $variables['field']->field_alias == 'views_php_6') {
		  $variables['field']->last_render = \Drupal\Core\Render\Markup::create($variables['field']->last_render);
		}
    }
    if (isset($variables['view']) && ($variables['view']->storage->id() == 'commerce_products' )) {
        if ($variables['field']->field_alias == 'views_php_6') {
		  $variables['field']->last_render = \Drupal\Core\Render\Markup::create($variables['field']->last_render);
		}
    }
    
    if (isset($variables['view']) && ($variables['view']->storage->id() == 'custom_order_report' )) {
		if ($variables['field']->field_alias == 'views_php_2') {
		  $variables['field']->last_render = \Drupal\Core\Render\Markup::create($variables['field']->last_render);
		}
    }
}

function _get_product_stock($product) {
    $vid = $product->variations[0];
    $pid = $product->product_id;
    $path = '';
    if($product->type=='default'){
        global $base_url;
        //$query = \Drupal::database()->query('SELECT sum(qty) as ava_qty FROM `commerce_stock_transaction` WHERE entity_id ='.$vid);
        //$data = $query->fetchField();
        $data = _get_stock_level($vid);
    	if(isset($data)){
			if($data>900000){
				$path = 'Always in stock.';
			}else{
				$path = "<a href='".$base_url."/admin/commerce/config/stock/transactions2?commerce_product_v_id=" . $vid . "' class='use-ajax'  data-dialog-type='modal'>$data</a>";
			}
		}else{
		$path = "<a href='".$base_url."/admin/commerce/config/stock/transactions2?commerce_product_v_id=" . $vid . "' class='use-ajax'  data-dialog-type='modal'> + Add Stock </a>";
        }
    
    }else{
        return "N/A";
    }
    return $path;
}
